PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
DIRECT_URL="postgresql://user:password@localhost:5432/dbname"

# JWT Auth Secret
JWT_SECRET="your-jwt-secret-key"

# OTP Configuration
STATIC_OTP=true

# Email Configuration
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM_NAME="Tax CRM Engine"
EMAIL_FROM_ADDRESS="no-reply@taxcrm.com"
