enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductTaxType {
  NO_TAX
  VAT_10
}

model Product {
  id          String         @id @default(uuid())
  name        String
  description String?
  price       Decimal        @db.Decimal(10, 2)
  unit        String
  taxType     ProductTaxType @default(NO_TAX)
  status      ProductStatus  @default(ACTIVE)
  createdById String?
  createdBy   User?          @relation("CreatedProducts", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  returnItems TaxApplicationItem[]

  @@index([status])
  @@index([name])
}
