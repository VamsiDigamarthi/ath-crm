enum NotificationCategory {
  FILING
  SALES
  PREP_REVIEW
  DOCUMENTER
  SYSTEM
  REJECTION_ALERT
}

enum NotificationPriority {
  CRITICAL
  HIGH
  NORMAL
  INFO
}

model Notification {
  id                   String               @id @default(uuid())
  recipientUserId      String?
  recipientUser        User?                @relation("UserNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  targetRole           Role?
  applicationId        String?
  application          TaxApplication?      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title                String
  message              String
  category             NotificationCategory @default(DOCUMENTER)
  priority             NotificationPriority @default(NORMAL)
  isRead               Boolean              @default(false)
  actionUrl            String?
  actionLabel          String?
  relatedLeadName      String?
  createdAt            DateTime             @default(now())

  @@index([recipientUserId])
  @@index([targetRole])
  @@index([category])
  @@index([isRead])
  @@index([createdAt])
}
