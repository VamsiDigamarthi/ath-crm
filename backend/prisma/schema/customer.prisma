model CustomerProfile {
  id                  String   @id @default(uuid())
  userId              String?  @unique
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ssnTin              String?
  firstName           String
  middleName          String?
  lastName            String
  email               String?
  phone               String
  dob                 String?
  occupation          String?
  visaType            String?
  maritalStatus       String?
  addressLine1        String?
  city                String?
  state               String?
  zipCode             String?
  isConvertedCustomer Boolean  @default(false)

  referralCode         String?           @unique
  referredByCustomerId String?
  referredByCustomer   CustomerProfile?  @relation("CustomerReferrals", fields: [referredByCustomerId], references: [id], onDelete: SetNull)
  referredCustomers    CustomerProfile[] @relation("CustomerReferrals")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  applications TaxApplication[]
  couponUsages CouponUsage[]

  @@index([ssnTin])
  @@index([email])
  @@index([phone])
  @@index([referredByCustomerId])
}
